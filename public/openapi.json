{
  "openapi": "3.0.3",
  "info": {
    "title": "HALLAYM Pay",
    "version": "1.0.0",
    "description": "Private gateway. Server-side only. Use unique order_id and verify paid status, base amount and order ID. No outgoing webhooks yet."
  },
  "servers": [
    {
      "url": "https://hallaym-pay.onrender.com"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/payments/create": {
      "post": {
        "summary": "Create payment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "amount",
                  "order_id"
                ],
                "properties": {
                  "amount": {
                    "type": "integer",
                    "minimum": 1000,
                    "maximum": 100000000
                  },
                  "order_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing payment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "409": {
            "description": "Conflict"
          },
          "502": {
            "description": "Uncertain provider result; review"
          },
          "503": {
            "description": "Unavailable"
          }
        }
      }
    },
    "/api/v1/payments/{id}": {
      "get": {
        "summary": "Get payment status",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Payment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Payment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "order_id": {
            "type": "string"
          },
          "base_amount": {
            "type": "integer"
          },
          "amount": {
            "type": "integer",
            "description": "Exact payable amount including 1–999 UZS matching offset"
          },
          "status": {
            "type": "string",
            "enum": [
              "creating",
              "pending",
              "paid",
              "cancelled",
              "review"
            ]
          },
          "checkout_url": {
            "type": "string",
            "format": "uri"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}